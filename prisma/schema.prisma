generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Household {
  id                      String                   @id @default(cuid())
  name                    String                   @unique
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  activityLogs            ActivityLog[]
  categories              Category[]
  inventoryItems          InventoryItem[]
  knownItems              KnownItem[]
  notificationPreferences NotificationPreference[]
  shoppingItems           ShoppingItem[]
  users                   User[]

  @@map("households")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String
  householdId             String                   @map("household_id")
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  activityLogs            ActivityLog[]
  createdShoppingItems    ShoppingItem[]           @relation("ShoppingItemCreator")
  household               Household                @relation(fields: [householdId], references: [id], onDelete: Cascade)
  notificationPreferences NotificationPreference[]

  @@unique([householdId, name])
  @@map("users")
}

model Category {
  id             String          @id @default(cuid())
  householdId    String          @map("household_id")
  name           String
  sortOrder      Int             @default(0) @map("sort_order")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  defaultFor     KnownItem[]      @relation("KnownItemDefaultCategory")
  household      Household       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  shoppingItems  ShoppingItem[]

  @@unique([householdId, name])
  @@index([householdId, sortOrder])
  @@map("categories")
}

model ShoppingItem {
  id              String     @id @default(cuid())
  householdId     String     @map("household_id")
  name            String
  normalizedName  String     @map("normalized_name")
  categoryId      String     @map("category_id")
  quantity        String?
  unit            String?
  note            String?
  isBought        Boolean    @default(false) @map("is_bought")
  boughtAt        DateTime?  @map("bought_at")
  createdByUserId String?    @map("created_by_user_id")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  category        Category   @relation(fields: [categoryId], references: [id])
  createdByUser   User?      @relation("ShoppingItemCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  household       Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@index([householdId, isBought, createdAt])
  @@index([householdId, normalizedName])
  @@map("shopping_items")
}

model InventoryItem {
  id                String    @id @default(cuid())
  householdId       String    @map("household_id")
  name              String
  normalizedName    String    @map("normalized_name")
  categoryId        String    @map("category_id")
  quantity          Float?
  unit              String?
  location          String    @default("")
  lowStockThreshold Float?    @map("low_stock_threshold")
  isRunningLow      Boolean   @default(false) @map("is_running_low")
  note              String?
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  category          Category  @relation(fields: [categoryId], references: [id])
  household         Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, normalizedName, location])
  @@index([householdId, location])
  @@index([householdId, isRunningLow])
  @@map("inventory_items")
}

model KnownItem {
  id                         String    @id @default(cuid())
  householdId                String    @map("household_id")
  name                       String
  normalizedName             String    @map("normalized_name")
  defaultCategoryId          String?   @map("default_category_id")
  defaultUnit                String?   @map("default_unit")
  timesAddedToShoppingList   Int       @default(0) @map("times_added_to_shopping_list")
  timesAddedToInventory      Int       @default(0) @map("times_added_to_inventory")
  lastUsedAt                 DateTime? @map("last_used_at")
  createdAt                  DateTime  @default(now()) @map("created_at")
  updatedAt                  DateTime  @updatedAt @map("updated_at")
  defaultCategory            Category? @relation("KnownItemDefaultCategory", fields: [defaultCategoryId], references: [id], onDelete: SetNull)
  household                  Household @relation(fields: [householdId], references: [id], onDelete: Cascade)

  @@unique([householdId, normalizedName])
  @@index([householdId, timesAddedToShoppingList])
  @@map("known_items")
}

model ActivityLog {
  id          String    @id @default(cuid())
  householdId String    @map("household_id")
  userId      String?   @map("user_id")
  action      String
  entityType  String    @map("entity_type")
  entityId    String?   @map("entity_id")
  metadata    String?
  createdAt   DateTime  @default(now()) @map("created_at")
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([householdId, createdAt])
  @@map("activity_logs")
}

model NotificationPreference {
  id                              String    @id @default(cuid())
  householdId                     String    @map("household_id")
  userId                          String    @map("user_id")
  enabled                         Boolean   @default(false)
  lowStockRemindersEnabled        Boolean   @default(true) @map("low_stock_reminders_enabled")
  weeklyShoppingReminderEnabled   Boolean   @default(false) @map("weekly_shopping_reminder_enabled")
  uncheckedItemsReminderEnabled   Boolean   @default(false) @map("unchecked_items_reminder_enabled")
  reminderDay                     String    @default("Saturday") @map("reminder_day")
  reminderTime                    String    @default("10:00") @map("reminder_time")
  createdAt                       DateTime  @default(now()) @map("created_at")
  updatedAt                       DateTime  @updatedAt @map("updated_at")
  household                       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user                            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([householdId, userId])
  @@map("notification_preferences")
}
